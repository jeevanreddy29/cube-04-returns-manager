# Returns Manager - Environment Configuration Template
# Duplicate this file to .env and configure your variables. Do NOT commit .env to version control.

# --- Google Gemini AI API Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini model. Defaults to gemini-1.5-flash for balanced speed, cost & vision support.
# Supported options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash, etc.
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=45
GEMINI_RETRY_COUNT=1

# --- Storage & Database ---
# SQLite default for local demo & evaluation runs
DATABASE_URL=sqlite:///./returns_manager.db

# --- Application Server ---
APP_ENV=development
LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0

# Tenant Image Storage
IMAGE_STORAGE_DIR=./storage/images
MAX_IMAGE_SIZE_BYTES=10485760
